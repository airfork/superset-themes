{
  "name": "superset-themes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:stories": "vitest --config vitest.storybook.config.ts --run",
    "browsers:install": "playwright install chromium",
    "build:pages": "GITHUB_PAGES=true pnpm build",
    "archive:clean": "node scripts/archive-clean.mjs",
    "archive:clean:dry-run": "node scripts/archive-clean.mjs --dry-run",
    "archive:clean:test": "node --test scripts/archive-clean.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "themes:validate": "node scripts/themes-validate.mjs",
    "themes:check-contrast": "node scripts/themes-check-contrast.mjs",
    "themes:research": "node scripts/themes-research.mjs",
    "themes:research:test": "node --test scripts/themes-research.test.mjs",
    "themes:generate": "tsx scripts/themes-generate.mjs",
    "themes:generate:test": "node --test scripts/themes-generate.test.mjs",
    "themes:uninstall": "node scripts/themes-uninstall.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.8",
    "culori": "^4.0.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.7",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "storybook": "^10.4.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
